{
    "name": "wsmallnews/preference",
    "description": "Wsmallnews system preference modules",
    "keywords": [
        "Wsmallnews",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "preference"
    ],
    "homepage": "https://github.com/wsmallnews/preference",
    "support": {
        "issues": "https://github.com/wsmallnews/preference/issues",
        "source": "https://github.com/wsmallnews/preference"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "smallnews",
            "email": "1371606921@qq.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "wsmallnews/support": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "Wsmallnews\\Preference\\": "src/",
            "Wsmallnews\\Preference\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wsmallnews\\Preference\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wsmallnews\\Preference\\PreferenceServiceProvider"
            ],
            "aliases": {
                "Preference": "Wsmallnews\\Preference\\Facades\\Preference"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}